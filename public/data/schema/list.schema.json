{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juchiang77608.github.io/shop-lists/data/schema/list.schema.json",
  "title": "ShopList",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "source", "collectedAt", "stores"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "清單唯一 id，建議與檔名一致"
    },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "author", "postedAt", "description"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "author": { "type": "string", "minLength": 1 },
        "postedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "description": { "type": "string" }
      }
    },
    "collectedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stores": {
      "type": "array",
      "items": { "$ref": "#/$defs/store" }
    }
  },
  "$defs": {
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "name",
        "threads",
        "items",
        "shopLinks",
        "line",
        "sourceComment"
      ],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "threads": {
          "type": "string",
          "minLength": 1,
          "description": "Threads 帳號，不含 @"
        },
        "items": { "type": "string" },
        "shopLinks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "line": { "type": "string" },
        "sourceComment": { "type": "string" }
      }
    }
  }
}
